{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovaTree",
  "version": "0.8.1",
  "identifier": "com.novatree.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NovaTree",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwMUUxREIxMzEyQ0M2RkMKUldUOHhpd3hzUjBlY05PYS9GVUF0djFHWHdMNWFiRWlNR1BOeUZJMmx0ckx2bGdId2V2MmlvYTIK",
      "endpoints": [
        "https://github.com/State-of-Economy/NovaTree/releases/latest/download/latest.json"
      ]
    }
  }
}
